{
  "expo": {
    "name": "Boniface",
    "slug": "nave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.boniface.barmanager"
    },
    "android": {
      "package": "com.boniface.barmanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#111827"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "2b48a973-20c9-4d25-833b-407770b06863"
      },
      "privacyUrl": "https://raw.githubusercontent.com/buv100/boniface/main/docs/privacy.html",
      "termsUrl": "https://raw.githubusercontent.com/buv100/boniface/main/docs/terms.html"
    },
    "owner": "nave123s-team"
  }
}
