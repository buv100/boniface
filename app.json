{
  "expo": {
    "name": "Boniface",
    "slug": "nave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.boniface.barmanager"
    },
    "android": {
      "package": "com.boniface.barmanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#111827"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Boniface",
      "shortName": "Boniface",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#111827",
      "backgroundColor": "#111827"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://boniface.expo.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "2b48a973-20c9-4d25-833b-407770b06863"
      },
      "privacyUrl": "https://raw.githubusercontent.com/buv100/boniface/main/docs/privacy.html",
      "termsUrl": "https://raw.githubusercontent.com/buv100/boniface/main/docs/terms.html"
    },
    "owner": "nave123s-team"
  }
}
